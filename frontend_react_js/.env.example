# Optional environment variables for Ocean Notes React App

# Base URL for API (optional, not required in local mode)
REACT_APP_API_BASE=https://api.yourdomain.com
REACT_APP_BACKEND_URL=https://backend.yourdomain.com
REACT_APP_FRONTEND_URL=https://frontend.yourdomain.com
REACT_APP_WS_URL=wss://ws.yourdomain.com

# Node environment (development/production)
REACT_APP_NODE_ENV=development

# Port for dev server
REACT_APP_PORT=3000
